#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$root"
case "${1:-}" in
  worktree | packages) exec "$root/scripts/bootstrap-worktree-engine" "$@" ;;
  *)
    printf '%s\n' 'Usage: ./bootstrap worktree prepare|check|plan [--json] [--offline] [--no-install], or packages setup|check [@thehypertextstudio/package]' >&2
    exit 2
    ;;
esac
