#!/usr/bin/env python3
"""commit-msg hook: auto-wrap body prose lines at 80 chars.

Subject line, blank lines, comment lines (#), indented lines, and
trailers (Co-Authored-By: etc.) are passed through unchanged."""
import sys
import textwrap

WRAP_WIDTH = 80
TRAILER_PREFIXES = (
    'Co-Authored-By:', 'Co-authored-by:', 'Signed-off-by:',
    'Fixes:', 'Closes:', 'Refs:',
)


def is_trailer(line):
    return any(line.startswith(p) for p in TRAILER_PREFIXES)


def wrap_paragraph(para_lines):
    text = ' '.join(l.strip() for l in para_lines if l.strip())
    return textwrap.fill(
        text, width=WRAP_WIDTH,
        break_long_words=False, break_on_hyphens=False,
    )


def process(msg):
    lines = msg.split('\n')
    out = []
    i = 0
    subject_done = False

    while i < len(lines):
        line = lines[i]

        if not subject_done:
            out.append(line)
            subject_done = True
            i += 1
            continue

        if line.startswith('#'):
            out.append(line)
            i += 1
            continue

        if not line.strip():
            out.append('')
            i += 1
            continue

        if is_trailer(line):
            out.append(line)
            i += 1
            continue

        if line.startswith('    ') or line.startswith('\t'):
            out.append(line)
            i += 1
            continue

        # Prose paragraph: collect consecutive body lines
        para = [line]
        j = i + 1
        while j < len(lines):
            nxt = lines[j]
            if (not nxt.strip()
                    or nxt.startswith('#')
                    or is_trailer(nxt)
                    or nxt.startswith('    ')
                    or nxt.startswith('\t')):
                break
            para.append(nxt)
            j += 1

        out.append(wrap_paragraph(para))
        i = j

    return '\n'.join(out)


if __name__ == '__main__':
    msg_file = sys.argv[1]
    with open(msg_file) as f:
        msg = f.read().rstrip('\n')
    with open(msg_file, 'w') as f:
        f.write(process(msg) + '\n')
