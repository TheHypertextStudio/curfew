#!/usr/bin/env python3
"""commit-msg hook: enforce Studio conventional commit types (feat, fix, chore)
and auto-wrap body prose lines at 80 chars.

Subject line, blank lines, comment lines (#), indented lines, and
trailers (Co-Authored-By: etc.) are passed through unchanged."""
import re
import sys
import textwrap

WRAP_WIDTH = 80
TRAILER_PREFIXES = (
    'Co-Authored-By:', 'Co-authored-by:', 'Signed-off-by:',
    'Fixes:', 'Closes:', 'Refs:',
)
HEADER_REGEX = re.compile(r'^(feat|fix|chore)\(([a-z0-9_-]+)\)(!)?: (.+)$')


def validate_subject(line):
    # Allow git internal / automated commit types unchanged
    if line.startswith(('Merge ', 'Revert ', 'fixup! ', 'squash! ')):
        return
    if not line.strip() or line.startswith('#'):
        return
    if not HEADER_REGEX.match(line):
        sys.stderr.write(
            f"\n"
            f"=======================================================================\n"
            f"  COMMIT MESSAGE VALIDATION FAILED\n"
            f"=======================================================================\n"
            f"Subject: {line}\n\n"
            f"All commit types except 'feat', 'fix', and 'chore' are banned company-wide.\n"
            f"Expected format: feat(scope): subject, fix(scope): subject, or chore(scope): subject.\n"
            f"Allowed types:   feat, fix, chore\n\n"
            f"Examples:\n"
            f"  feat(enforcement): show warning banner before schedule lockout\n"
            f"  fix(sync): resolve durable object reconnection drop\n"
            f"  chore(dx): update snapshot harness and scripts\n"
            f"=======================================================================\n\n"
        )
        sys.exit(1)


def is_trailer(line):
    return any(line.startswith(p) for p in TRAILER_PREFIXES)


def wrap_paragraph(para_lines):
    text = ' '.join(l.strip() for l in para_lines if l.strip())
    return textwrap.fill(
        text, width=WRAP_WIDTH,
        break_long_words=False, break_on_hyphens=False,
    )


def process(msg):
    lines = msg.split('\n')
    out = []
    i = 0
    subject_done = False

    while i < len(lines):
        line = lines[i]

        if not subject_done:
            validate_subject(line)
            out.append(line)
            subject_done = True
            i += 1
            continue

        if line.startswith('#'):
            out.append(line)
            i += 1
            continue

        if not line.strip():
            out.append('')
            i += 1
            continue

        if is_trailer(line):
            out.append(line)
            i += 1
            continue

        if line.startswith('    ') or line.startswith('\t'):
            out.append(line)
            i += 1
            continue

        # Prose paragraph: collect consecutive body lines
        para = [line]
        j = i + 1
        while j < len(lines):
            nxt = lines[j]
            if (not nxt.strip()
                    or nxt.startswith('#')
                    or is_trailer(nxt)
                    or nxt.startswith('    ')
                    or nxt.startswith('\t')):
                break
            para.append(nxt)
            j += 1

        out.append(wrap_paragraph(para))
        i = j

    return '\n'.join(out)


if __name__ == '__main__':
    msg_file = sys.argv[1]
    with open(msg_file) as f:
        msg = f.read().rstrip('\n')
    with open(msg_file, 'w') as f:
        f.write(process(msg) + '\n')
