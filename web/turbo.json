{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {
      "inputs": ["src/**/*.ts", "tsconfig.json", "$TURBO_DEFAULT$"],
      "outputs": []
    },
    "deploy": {
      "cache": false,
      "dependsOn": ["typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "remoteCache": {
    "apiUrl": "https://turbo-cache.hypertext.studio",
    "teamSlug": "curfew-web",
    "signature": true
  }
}
