{
  "name": "curfew-monorepo",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo run dev",
    "deploy": "turbo run deploy",
    "build": "pnpm --filter @curfew/chrome-extension build",
    "test": "pnpm --filter @curfew/license-worker test && pnpm --filter @curfew/chrome-extension test",
    "typecheck": "pnpm --filter @curfew/license-worker typecheck && pnpm --filter @curfew/chrome-extension typecheck"
  },
  "devDependencies": {
    "turbo": "^2"
  }
}
