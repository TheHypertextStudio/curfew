{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "curfew-site",
  "account_id": "2500680a3b2b0fe6a011c1c25fed5008",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/docs", "/docs/*", "/_mintlify/*", "/mintlify-assets/*", "/api/request"]
  },
  "env": {
    "staging": {
      "name": "curfew-site-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "DOCS_MODE": "html-guide",
        "DOCS_UPSTREAM": "https://curfew.mintlify.site"
      }
    },
    "production": {
      "name": "curfew-site-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "DOCS_MODE": "html-guide",
        "DOCS_UPSTREAM": "https://curfew.mintlify.site"
      }
    }
  }
}
