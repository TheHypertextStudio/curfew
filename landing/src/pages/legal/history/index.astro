---
import Experience from '../../../layouts/Experience.astro';
const content = `<section><h1>Policy history</h1><p>Curfew policies were updated on October 14, 2026. Privacy and Data Retention took effect that day. The Terms explain when they apply.</p><h2>Current policies</h2><p><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/refund">Refunds</a> · <a href="/retention">Data Retention</a></p><h2>What changed</h2><p>The update explains account eligibility, content use, assistant sharing, browser task reviews, retention, and account deletion. It confirms renewal refunds and offline license rights, identifies the operator and legal contact, and adds Nevada law and courts while preserving mandatory consumer and home-jurisdiction protections. Existing purchase, lifetime license, MIT, and refund rights are preserved.</p><h2>Previous documents</h2><p>These exact copies preserve the policies in place before the update. October 13 is the archive label, not their original effective date.</p><ul><li><a href="/legal/history/2026-10-13/privacy">Previous Privacy Policy</a></li><li><a href="/legal/history/2026-10-13/terms">Previous Terms</a></li><li><a href="/legal/history/2026-10-13/refund">Previous Refund Policy</a></li><li><a href="/legal/history/2026-10-13/retention">Previous Data Retention Policy</a></li></ul><p>Legal and privacy requests: <a href="mailto:legal@hypertext.studio">legal@hypertext.studio</a>.</p></section>`;
---

<Experience
  title="Policy history"
  description="Previous Curfew legal policies and change notices."
  content={content}
/>
