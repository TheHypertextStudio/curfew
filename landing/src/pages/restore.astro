---
import Page from '../layouts/Page.astro';
import PurchasePanel from '../components/PurchasePanel.astro';
---

<Page
  title="Restore Curfew Plus"
  description="Restore your purchase using the email address on your receipt."
>
  <Fragment slot="head"
    ><meta name="robots" content="noindex" /><meta
      name="referrer"
      content="no-referrer"
    /></Fragment
  >
  <header class="site-header">
    <nav>
      <a href="/" class="wordmark">Curfew</a><a class="nav-account" href="/account">Open Account</a>
    </nav>
  </header>
  <main><section><div class="section-inner"><PurchasePanel mode="restore" /></div></section></main>
  <footer>
    <p>Made by <a href="https://hypertext.studio">Hypertext Studio</a>.</p><p>
      <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/support">Support</a>
    </p>
  </footer>
</Page>
