---
import Experience from '../layouts/Experience.astro';
import PurchasePanel from '../components/PurchasePanel.astro';
---

<Experience
  title="Restore Curfew Plus"
  description="Restore your purchase using the email address on your receipt."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="no-referrer" />
  </Fragment>
  <PurchasePanel mode="restore" />
</Experience>
