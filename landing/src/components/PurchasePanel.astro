---
import { purchaseProfile } from '../lib/purchase-profile';
interface Props {
  mode: 'checkout' | 'restore';
}
const { mode } = Astro.props;
const { issuer, scheme } = purchaseProfile(process.env.CURFEW_DEPLOYMENT_MODE || 'production');
---

<div class="purchase-panel" data-purchase-mode={mode} data-issuer={issuer} data-scheme={scheme}>
  <h1>{mode === 'checkout' ? 'Activate Curfew Plus' : 'Restore Curfew Plus'}</h1>
  <p id="purchase-status" role="status" aria-live="polite"></p>
  <div id="state-loading" hidden>
    <p>Preparing your purchase…</p>
  </div>
  <div id="state-success" hidden>
    <p class="lede">Open Curfew to activate Plus on this Mac.</p>
    <a id="activate-link" class="button primary">
      {mode === 'checkout' ? 'Activate in Curfew' : 'Restore in Curfew'}
    </a>
    <p class="purchase-help">
      Need the app? <a href="/download">Download Curfew for Mac</a>.
    </p>
    <details id="manual-entry">
      <summary>Enter a license key</summary>
      <div id="manual-key" hidden>
        <pre><code id="license-key" /></pre>
        <button type="button" class="button secondary" id="copy-btn">
          Copy License Key
        </button>
        <p>
          In Curfew, open <strong>Settings → About → Curfew Plus</strong>, enter your key, and
          choose <strong>Activate</strong>.
        </p>
      </div>
    </details>
    <p class="purchase-help">
      Stripe emails your payment receipt. <a href="/restore">Restore a purchase</a> ·{' '}
      <a href="https://curfew.mintlify.site/docs/licensing">Activation help</a>
    </p>
  </div>
  <form id="restore-form" hidden>
    <p class="lede">Enter the email address on your receipt.</p>
    <label for="purchase-email">Purchase email</label>
    <input
      id="purchase-email"
      name="email"
      type="email"
      autocomplete="email"
      required
      maxlength="254"
    />
    <button type="submit" class="button primary">
      Send Restore Link
    </button>
  </form>
  <div id="state-error" hidden>
    <p id="error-detail" role="alert"></p>
    <button type="button" class="button secondary" id="retry-btn">
      Try Again
    </button>
    <p>
      <a href="/restore">Restore a purchase</a> or{' '}
      <a href="mailto:support@thecurfew.app">contact support</a>.
    </p>
  </div>
</div>
<style>
  .purchase-panel {
    max-width: 40rem;
  }
  [hidden] {
    display: none !important;
  }
  .purchase-help {
    color: var(--on-surface-variant);
    font-size: var(--type-small);
    margin-top: var(--space-5);
  }
  .purchase-help a,
  #manual-key p a,
  #state-error a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  details {
    margin-top: var(--space-6);
  }
  summary {
    cursor: pointer;
  }
  pre {
    background: var(--surface-container);
    border: var(--stroke) solid var(--outline);
    border-radius: var(--radius-small);
    padding: var(--space-4);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  #manual-key p {
    color: var(--on-surface-variant);
    line-height: 1.7;
  }
  form {
    max-width: 24rem;
  }
  label {
    display: block;
    margin: var(--space-6) 0 var(--space-2);
    font-weight: 600;
  }
  input {
    box-sizing: border-box;
    width: 100%;
    font: inherit;
    padding: var(--space-3);
    border: var(--stroke) solid var(--outline);
    border-radius: var(--radius-small);
    background: var(--surface-container);
    color: var(--on-surface);
  }
  input:focus-visible {
    outline: var(--focus-width) solid var(--focus-color);
    outline-offset: var(--space-1);
  }
  form button {
    margin-top: var(--space-4);
  }
  button {
    font-family: inherit;
  }
  button.primary {
    border: 0;
  }
  #error-detail {
    color: var(--error);
  }
  #purchase-status {
    line-height: 1.6;
  }
</style>
<script is:inline type="module" src="/purchase.js"></script>
