---
import { footer, header, symbols } from '../../public/site-assets/design/components.mjs';
import { labelPolicyTables } from '../lib/policy-tables.mjs';
import { stylesheet } from '../lib/stylesheet-url.mjs';

interface Props {
  title: string;
  description: string;
  content?: string;
  home?: boolean;
}

const { title, description, content: rawContent, home = false } = Astro.props;
const siteOrigin = Astro.site!.origin;
const content = rawContent
  ?.replaceAll('{{SITE_ORIGIN}}', siteOrigin)
  .replaceAll('/design/', '/site-assets/design/');
---

<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbf7ef" />
    <title>{title} — Curfew</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:title" content={`${title} — Curfew`} />
    <meta property="og:image" content={new URL('/images/og.png', Astro.site).href} />
    <link rel="icon" href="/images/favicon.png" />
    <script is:inline src="/site-assets/design/theme-init.js"></script>
    <link
      rel="preload"
      href="/site-assets/design/fonts/Calistoga-Regular.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link rel="stylesheet" href="/site-assets/design/tokens.css" />
    <link rel="stylesheet" href="/site-assets/design/components.css" />
    <link rel="stylesheet" href={stylesheet('curfew.css')} />
    {!home && <link rel="stylesheet" href={stylesheet('curfew-pages.css')} />}
    <script is:inline src="/site-assets/design/theme.js" defer></script>
    <script is:inline type="module" src="/site-assets/design/landscape.js"></script>
    <script is:inline type="module" src="/site-assets/design/motion.js"></script>
    <slot name="head" />
  </head>
  <body class={home ? 'home-page' : undefined}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Fragment set:html={symbols} />
    <Fragment set:html={header()} />
    <main id="main" class={home ? undefined : 'reading wrap'}>
      {content === undefined ? <slot /> : <Fragment set:html={labelPolicyTables(content)} />}
    </main>
    <Fragment set:html={footer({ compact: !home })} />
  </body>
</html>
