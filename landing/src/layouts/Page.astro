---
import '@thehypertextstudio/web-tokens/tokens.css';
interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  stylesheet?: string;
  viewport?: boolean;
  viewportContent?: string;
}
const {
  title,
  description,
  bodyClass,
  stylesheet = '/style.css',
  viewport = true,
  viewportContent = 'width=device-width, initial-scale=1.0',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {viewport && <meta name="viewport" content={viewportContent} />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {stylesheet && <link rel="stylesheet" href={stylesheet} />}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
