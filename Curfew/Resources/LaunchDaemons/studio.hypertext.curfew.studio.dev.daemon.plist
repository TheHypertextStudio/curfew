<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>studio.hypertext.curfew.studio.dev.daemon</string>
    <key>BundleProgram</key>
    <string>Contents/Resources/curfew-daemon</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>CURFEW_FLAVOR</key>
        <string>development</string>
    </dict>
    <key>StartInterval</key>
    <integer>15</integer>
    <key>KeepAlive</key>
    <dict>
        <key>PathState</key>
        <dict>
            <key>/Library/Application Support/Curfew (Studio Dev)/lockout-active</key>
            <true/>
        </dict>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>MachServices</key>
    <dict>
        <key>studio.hypertext.curfew.studio.dev.daemon</key>
        <true/>
    </dict>
</dict>
</plist>
