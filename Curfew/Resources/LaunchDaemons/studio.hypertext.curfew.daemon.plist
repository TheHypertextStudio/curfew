<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Curfew privileged daemon installed by SMAppService.daemon(plistName:). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>studio.hypertext.curfew.daemon</string>

    <key>BundleProgram</key>
    <string>Contents/Resources/curfew-daemon</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>CURFEW_FLAVOR</key>
        <string>production</string>
    </dict>

    <!--
      Wake periodically so an unlocked Mac can discover a remotely delivered
      command before a lockout sentinel exists. Once enforcement begins,
      PathState keeps the helper resident for the duration of the lockout.
    -->
    <key>StartInterval</key>
    <integer>15</integer>

    <key>KeepAlive</key>
    <dict>
        <key>PathState</key>
        <dict>
            <key>/Library/Application Support/Curfew/lockout-active</key>
            <true/>
        </dict>
    </dict>
    <key>RunAtLoad</key>
    <true/>

    <key>MachServices</key>
    <dict>
        <key>studio.hypertext.curfew.daemon</key>
        <true/>
    </dict>
</dict>
</plist>
