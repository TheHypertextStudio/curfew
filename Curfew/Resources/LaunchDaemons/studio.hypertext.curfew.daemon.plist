<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Curfew privileged daemon — installed by SMAppService.daemon(plistName:).

  Responsibilities (v0.2):
    1. Watches the shared lockout-state file for unexpected "unlocked" transitions
       during an active lockout session.
    2. Calls /sbin/shutdown -h +0 as a last-resort consequence when the user
       breaks out of lockout without going through the "Convince Me" flow.

  The binary is built as a separate executable target "curfew-daemon" and
  bundled at Curfew.app/Contents/Library/LaunchDaemons/curfew-daemon.
  SMAppService requires the plist to live alongside the binary.

  NOTE: This plist is bundled into the app but the daemon is NOT automatically
  installed. The user must explicitly click "Install Privileged Helper" in
  Settings → Integrations, which triggers an SMAppService authorisation prompt.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>studio.hypertext.curfew.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/Curfew/curfew-daemon</string>
    </array>

    <!--
      Run on demand: the daemon is kept alive by SMAppService across reboots
      via KeepAlive.PathState pointing at the lockout-state file. When the
      file disappears, the daemon exits cleanly.
    -->
    <key>KeepAlive</key>
    <dict>
        <key>PathState</key>
        <dict>
            <key>/Library/Application Support/Curfew/lockout-active</key>
            <true/>
        </dict>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <!-- Restrict network access — the daemon only reads the local state file. -->
    <key>Sockets</key>
    <dict/>
</dict>
</plist>
