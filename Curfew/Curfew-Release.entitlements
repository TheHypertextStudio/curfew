<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Release entitlements. Adds the iCloud container so CloudKit sync
      works on distributed builds signed with Developer ID. Local tests
      use Curfew.entitlements (Debug) which omits iCloud so ad-hoc
      signing succeeds.
    -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.studio.hypertext.curfew</string>
    </array>

    <!-- Auto-shutdown uses Apple Events to ask System Events to shut down
         the Mac. Keep this in the release entitlements so signed builds can
         surface the shutdown UI once automation approval is granted. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.studio.hypertext.curfew</string>
    </array>

    <!-- Silent-push for CloudKit `CKDatabaseSubscription`. Production
         push environment — must pair with the APNs certificate in the
         Apple Developer portal. -->
    <key>aps-environment</key>
    <string>production</string>
</dict>
</plist>
