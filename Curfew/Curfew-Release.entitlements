<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- v0.1 ships WidgetKit, MCP, the privileged helper, and shutdown.
         CloudKit and Calendar remain compiled but disabled. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Auto-shutdown uses Apple Events to ask System Events to shut down
         the Mac. Keep this in the release entitlements so signed builds can
         surface the shutdown UI once automation approval is granted. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Declare the existing Xcode read-only user-selected-file capability so
         the source policy exactly matches the signed artifact. -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>

    <!-- Keep existing Data Protection Keychain credentials accessible after
         the bundle rename. The first access group remains the legacy default. -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)studio.hypertext.curfew</string>
    </array>

    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.studio.hypertext.apps.curfew</string>
    </array>

    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:account.thecurfew.app</string>
        <string>webcredentials:account.thecurfew.app</string>
    </array>

</dict>
</plist>
