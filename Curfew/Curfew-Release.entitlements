<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- v0.1 ships WidgetKit, MCP, the privileged helper, and shutdown.
         CloudKit and Calendar remain compiled but disabled. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Auto-shutdown uses Apple Events to ask System Events to shut down
         the Mac. Keep this in the release entitlements so signed builds can
         surface the shutdown UI once automation approval is granted. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.studio.hypertext.curfew</string>
    </array>
</dict>
</plist>
